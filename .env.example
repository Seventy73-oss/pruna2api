# pruna2api 环境变量示例
# 复制为 .env 或直接写进 systemd 单元

# ---- 服务 ----
PRUNA_PORT=3020
PRUNA_DATA_DIR=/opt/pruna2api/data
PRUNA_MEDIA_DIR=/opt/pruna2api/media

# 对公网开放前**必须**设置，留空 = 不校验
PRUNA_API_KEY=

# 留空则按请求 Host 自动拼；反代到域名时建议显式指定
PRUNA_PUBLIC_BASE=

# 并发处理的任务数
PRUNA_MAX_WORKERS=4

# 提交阶段的串行锁等待（秒）
PRUNA_SUBMIT_TIMEOUT=600

# ---- 出口池 ----
# mihomo = 用自带的 mihomo + 你的订阅节点（推荐）
# system = 用系统 clash 里的固定出口
PRUNA_EXIT_SOURCE=mihomo

# 自带 mihomo 的控制面与代理入口（注意与系统 clash 的 9090/7890 错开）
PRUNA_MIHOMO_API=http://127.0.0.1:9091
PRUNA_MIHOMO_PROXY=http://127.0.0.1:7891
PRUNA_MIHOMO_GROUP=PRUNA

# mihomo 工作目录（存放 config.yaml / subscription.txt / providers）
PRUNA_MIHOMO_DIR=/opt/pruna2api/mihomo

# proxy-providers 中的 provider 名
PRUNA_MIHOMO_PROVIDER=sub

# 拉订阅时用的 User-Agent（部分机场按 UA 返回不同格式）
PRUNA_SUB_UA=clash.meta

# system 模式下的系统 clash 控制面
PRUNA_CLASH_API=http://127.0.0.1:9090
PRUNA_CLASH_SELECTOR=PROXY

# ---- 上游 ----
# 提交是否串行化（mihomo selector 是全局状态，串行避免并发切换打架）
PRUNA_SERIALIZE_SUBMIT=1
